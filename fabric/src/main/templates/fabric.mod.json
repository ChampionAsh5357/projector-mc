{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_authors}"
    ],
    "license": "${mod_license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "${mod_entrypoint}"
        ],
        "client": [
            "${mod_client_entrypoint}"
        ],
        "fabric-datagen": [
            "${mod_data_entrypoint}"
        ]
    },
    "mixins": [
        {
            "config": "${mod_id}.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}",
        "fabric-api": ">=${fabric_api_version}"
    }
}